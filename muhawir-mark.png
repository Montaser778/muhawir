<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="1000" height="1000" role="img" aria-label="Muhawir — voice interview agent">
  <defs>
    <!-- Subtle vignette so the mark sits in space rather than on a flat slab -->
    <radialGradient id="vignette" cx="50%" cy="42%" r="72%">
      <stop offset="0%" stop-color="#16181d"/>
      <stop offset="100%" stop-color="#08090b"/>
    </radialGradient>

    <linearGradient id="cyanFade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#4dd8e6" stop-opacity="0.15"/>
      <stop offset="22%" stop-color="#4dd8e6" stop-opacity="1"/>
      <stop offset="100%" stop-color="#4dd8e6" stop-opacity="1"/>
    </linearGradient>

    <linearGradient id="amberFade" x1="1" y1="0" x2="0" y2="0">
      <stop offset="0%" stop-color="#ffb627" stop-opacity="0.15"/>
      <stop offset="22%" stop-color="#ffb627" stop-opacity="1"/>
      <stop offset="100%" stop-color="#ffb627" stop-opacity="1"/>
    </linearGradient>

    <filter id="glowCyan" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="9" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <filter id="glowAmber" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="9" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <rect width="1000" height="1000" fill="url(#vignette)"/>

  <!-- Faint frame: the "room" the conversation happens in -->
  <rect x="60" y="60" width="880" height="880" rx="28"
        fill="none" stroke="#23272e" stroke-width="1.5"/>

  <!-- Corner ticks — a quiet nod to a technical instrument -->
  <g stroke="#2e343d" stroke-width="2" stroke-linecap="square">
    <path d="M60 128 L60 88 L100 88"/>
    <path d="M900 88 L940 88 L940 128"/>
    <path d="M940 872 L940 912 L900 912"/>
    <path d="M100 912 L60 912 L60 872"/>
  </g>

  <!-- ── The mark: two voices sharing one baseline ──────────────
       This is the same idea as the live interface. The candidate
       speaks upward in cyan, the interviewer answers downward in
       amber, and they meet on a single shared line. -->

  <line x1="150" y1="470" x2="850" y2="470" stroke="#2b3038" stroke-width="1.5"/>

  <!-- Candidate: irregular, human, tapering in -->
  <g fill="url(#cyanFade)" filter="url(#glowCyan)">
    <rect x="150" y="446" width="11" height="24" rx="5.5"/>
    <rect x="177" y="424" width="11" height="46" rx="5.5"/>
    <rect x="204" y="392" width="11" height="78" rx="5.5"/>
    <rect x="231" y="356" width="11" height="114" rx="5.5"/>
    <rect x="258" y="404" width="11" height="66" rx="5.5"/>
    <rect x="285" y="330" width="11" height="140" rx="5.5"/>
    <rect x="312" y="296" width="11" height="174" rx="5.5"/>
    <rect x="339" y="368" width="11" height="102" rx="5.5"/>
    <rect x="366" y="318" width="11" height="152" rx="5.5"/>
    <rect x="393" y="278" width="11" height="192" rx="5.5"/>
    <rect x="420" y="344" width="11" height="126" rx="5.5"/>
    <rect x="447" y="400" width="11" height="70" rx="5.5"/>
    <rect x="474" y="356" width="11" height="114" rx="5.5"/>
    <rect x="501" y="430" width="11" height="40" rx="5.5"/>
  </g>

  <!-- Interviewer: measured, more even, answering back -->
  <g fill="url(#amberFade)" filter="url(#glowAmber)">
    <rect x="849" y="470" width="11" height="26" rx="5.5"/>
    <rect x="822" y="470" width="11" height="52" rx="5.5"/>
    <rect x="795" y="470" width="11" height="88" rx="5.5"/>
    <rect x="768" y="470" width="11" height="124" rx="5.5"/>
    <rect x="741" y="470" width="11" height="96" rx="5.5"/>
    <rect x="714" y="470" width="11" height="146" rx="5.5"/>
    <rect x="687" y="470" width="11" height="118" rx="5.5"/>
    <rect x="660" y="470" width="11" height="162" rx="5.5"/>
    <rect x="633" y="470" width="11" height="134" rx="5.5"/>
    <rect x="606" y="470" width="11" height="104" rx="5.5"/>
    <rect x="579" y="470" width="11" height="146" rx="5.5"/>
    <rect x="552" y="470" width="11" height="82" rx="5.5"/>
    <rect x="525" y="470" width="11" height="118" rx="5.5"/>
  </g>

  <!-- The meeting point: where turn-taking actually happens -->
  <circle cx="512" cy="470" r="7" fill="#0a0b0d" stroke="#e6e8eb" stroke-width="2.5"/>

  <!-- ── Type ──────────────────────────────────────────────── -->
  <text x="500" y="762" text-anchor="middle"
        font-family="'JetBrains Mono', ui-monospace, monospace"
        font-size="21" letter-spacing="9" fill="#ffb627">VOICE INTERVIEW AGENT</text>

  <text x="500" y="838" text-anchor="middle"
        font-family="'Space Grotesk', 'Helvetica Neue', sans-serif"
        font-size="76" font-weight="700" letter-spacing="-1.5" fill="#e6e8eb">Muhawir</text>

  <text x="500" y="886" text-anchor="middle"
        font-family="'JetBrains Mono', ui-monospace, monospace"
        font-size="15" letter-spacing="3.5" fill="#6b7280">ADAPTIVE · SCORED · &lt; 800 ms</text>
</svg>
