# Front-end + /start proxy only. The bot lives on Pipecat Cloud, so none of
# the audio stack belongs in this image — it stays small and builds fast.
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    aiohttp \
    python-dotenv \
    openai

COPY server.py .
COPY report.py .
COPY store.py .
COPY rubric.py .
COPY config.py .
COPY static/ static/

EXPOSE 8080

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]